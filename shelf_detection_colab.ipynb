    "        'file': fname,\n",
    "        'model': DEMO_MODEL_NAME,\n",
    "        'count': count,\n",
    "        'avg_confidence': avg_c,\n",
    "        'inference_ms': ms,\n",
    "        'conf_threshold': CONF_THRESHOLD\n",
    "    })\n",
    "    print(f'  История записана →    {HISTORY_PATH}')"
