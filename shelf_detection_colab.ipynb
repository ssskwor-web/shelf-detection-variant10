   "source": [
    "# Загрузи своё изображение\n",
    "from google.colab import files\n",
    "import io\n",
    "\n",
    "print('📁 Загрузи фото полки магазина:')\n",
    "uploaded = files.upload()\n",
    "\n",
    "for fname, data in uploaded.items():\n",
    "    img = Image.open(io.BytesIO(data)).convert('RGB')\n",
    "    img_np = np.array(img)\n",
    "\n",
    "    # Детекция лучшей моделью\n",
    "    if 'YOLO' in DEMO_MODEL_NAME or 'DETR' in DEMO_MODEL_NAME:\n",
    "        from ultralytics import YOLO, RTDETR\n",
    "        m = (RTDETR if 'DETR' in DEMO_MODEL_NAME else YOLO)(DEMO_WEIGHTS)\n",
    "        t0 = time.time()\n",
    "        res = m.predict(img_np, conf=CONF_THRESHOLD, verbose=False)\n",
    "        ms  = round((time.time()-t0)*1000, 1)\n",
    "        boxes  = res[0].boxes.xyxy.cpu().numpy().tolist() if res[0].boxes else []\n",
    "        scores = res[0].boxes.conf.cpu().numpy().tolist() if res[0].boxes else []\n",
    "    else:\n",
    "        import torchvision.transforms as T\n",
    "        tfm = T.Compose([T.ToTensor(),\n",
    "                         T.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])])\n",
    "        inp = [tfm(img).to(device)]\n",
    "        if 'Faster' in DEMO_MODEL_NAME:\n",
    "            dm = frcnn\n",
    "        else:\n",
    "            dm = ssd_model\n",
    "        dm.eval()\n",
    "        t0 = time.time()\n",
    "        with torch.no_grad():\n",
    "            out = dm(inp)[0]\n",
    "        ms = round((time.time()-t0)*1000,1)\n",
    "        keep   = out['scores'] > CONF_THRESHOLD\n",
    "        boxes  = out['boxes'][keep].cpu().numpy().tolist()\n",
    "        scores = out['scores'][keep].cpu().numpy().tolist()\n",
    "\n",
    "    count = len(boxes)\n",
    "    avg_c = round(sum(scores)/len(scores),3) if scores else 0\n",
    "\n",
    "    # Отрисовка\n",
    "    result_img = draw_boxes(img_np, boxes, scores)\n",
    "    display(result_img)\n",
    "\n",
    "    # Вывод статистики\n",
    "    print(f'\\n📊 Результаты:')\n",
